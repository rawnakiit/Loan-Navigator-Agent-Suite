# Ignore local virtual environments
.venv/
venv/
env/

# Ignore Python cache and logs
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache/
.ipynb_checkpoints/

# Ignore local config/secret files (we'll set these up via environment variables/Secret Manager)
app/.env
.env

# Ignore system files
.DS_Store
Thumbs.db

# Ignore local git files (optional, but keeps the upload clean)
.git/
.gitignore
